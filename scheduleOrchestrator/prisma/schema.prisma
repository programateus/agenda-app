generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum EntryFrequency {
  Daily
  Weekly
  Monthly
  Yearly
  Custom
  None
}

model ProcessedEvent {
  id          String   @id
  source      String
  detailType  String
  processedAt DateTime @default(now())
}

model PendingScheduleAction {
  id                  String   @id
  threadId            String   @unique
  chatId              String   @unique
  userId              String
  traceId             String
  operation           String
  payload             Json
  confirmationMessage String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model ChatHistoryMessage {
  id         String   @id
  chatId     String
  userId     String?
  traceId    String
  senderRole String
  content    String
  createdAt  DateTime
  updatedAt  DateTime @updatedAt

  @@index([chatId, createdAt])
}

model Entry {
  id        String    @id
  userId    String
  title     String
  startDate DateTime
  endDate   DateTime
  until     DateTime?
  frequency String
  createdAt DateTime
  updatedAt DateTime

  entryOccurrences EntryOccurrence[]
}

model EntryOccurrence {
  id                String   @id
  entryId           String
  title             String
  startDate         DateTime
  originalStartDate DateTime
  endDate           DateTime
  isCanceled        Boolean
  createdAt         DateTime
  updatedAt         DateTime

  entry Entry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([entryId, originalStartDate])
}
