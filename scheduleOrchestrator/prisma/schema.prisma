generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum EntryFrequency {
  Daily
  Weekly
  Monthly
  Yearly
  Custom
  None
}

model ProcessedEvent {
  id          String   @id
  source      String
  detailType  String
  processedAt DateTime @default(now())
}

model Entry {
  id        String    @id
  userId    String
  title     String
  startDate DateTime
  endDate   DateTime
  until     DateTime?
  frequency String
  createdAt DateTime
  updatedAt DateTime

  entryOccurrences EntryOccurrence[]
}

model EntryOccurrence {
  id                String   @id
  entryId           String
  title             String
  startDate         DateTime
  originalStartDate DateTime
  endDate           DateTime
  isCanceled        Boolean
  createdAt         DateTime
  updatedAt         DateTime

  entry Entry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([entryId, originalStartDate])
}
